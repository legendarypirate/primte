PORT=3151
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prime
DB_USER=postgres
DB_PASS=your-password
JWT_SECRET=change-me
JWT_EXPIRES=7d
ADMIN_ORIGIN=http://localhost:3150

# Mongolia MO SMS phone verification (https://api.verify.mn)
# Required for member registration. Never commit the real key.
VERIFY_MN_API_KEY=

# Firebase Cloud Messaging — club open/close push to every device
# Download a service account JSON from Firebase Console → Project settings → Service accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
